# ==============================================================
# SANGUCHERÍA INTELIGENTE — VARIABLES DE ENTORNO
# ==============================================================
# Copia este archivo con el nombre .env en la carpeta /backend o en la raíz
# y completa los valores con tus credenciales.

# --- SERVIDOR Y RED ---
HOST=127.0.0.1
PUERTO=8000
ENTORNO=development

# --- BASE DE DATOS (SUPABASE) ---
# Opcional: Si no se configuran, el sistema utilizará el catálogo local estructurado.
SUPABASE_URL=https://tu-proyecto-aqui.supabase.co
SUPABASE_KEY=tu-anon-public-key-aqui

# --- INTELIGENCIA ARTIFICIAL (DEEPSEEK) ---
# Opcional: Utilizado por el Chef IA "Lucho" para recomendaciones y antojos.
# Si no se configura, el sistema cuenta con motor heurístico local de respaldo.
DEEPSEEK_API_KEY=tu_deepseek_api_key_aqui
