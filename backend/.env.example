# ==============================================================
# SANGUCHERÍA INTELIGENTE — BACKEND VARIABLES DE ENTORNO
# ==============================================================
# Copia este archivo como .env dentro de esta misma carpeta (backend/)

HOST=127.0.0.1
PUERTO=8000
ENTORNO=development

# SUPABASE (Opcional, tiene catálogo local de respaldo)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key

# DEEPSEEK IA (Opcional, tiene motor de recomendación heurístico de respaldo)
DEEPSEEK_API_KEY=tu-deepseek-api-key
